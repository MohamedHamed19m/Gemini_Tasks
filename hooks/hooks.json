{
  "hooks": {
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "display-tasks",
            "type": "command",
            "command": "node ${extensionPath}/hooks/before-agent.js",
            "description": "Display pending tasks before agent starts"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "ralph-loop-check",
            "type": "command",
            "command": "node ${extensionPath}/hooks/after-agent.js",
            "description": "Ralph Wiggum loop: verify completion and force retry if needed",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
