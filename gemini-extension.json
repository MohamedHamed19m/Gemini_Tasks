{
  "name": "gemini-tasks",
  "version": "1.0.0",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "gemini-tasks": {
      "command": "uv",
      "args": [
        "--directory",
        "${extensionPath}${/}server",
        "run",
        "main.py"
      ],
      "cwd": "${extensionPath}${/}server"
    }
  },
  "settings": [
    {
      "name": "Task List ID",
      "description": "Shared task list identifier for multi-session coordination",
      "envVar": "GEMINI_TASK_LIST_ID"
    }
  ]
}
